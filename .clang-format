# Cox formatting rules.
#
# The README states the project follows the Google C++ Style Guide, and this
# file makes that claim mechanically checkable (`clang-format --dry-run
# --Werror`) instead of merely aspirational.
#
# ONE DELIBERATE DEVIATION: IndentWidth is 4, not Google's 2. That matches the
# existing code (measured across net/, http/, tls/ and logging/), and changing
# it would reformat essentially every file, burying real history in noise.
# Everything else follows Google.
---
Language: Cpp
BasedOnStyle: Google

IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 80

# Keep the existing "public:"-first layout readable.
IndentAccessModifiers: false

# Includes: Cox headers are found via target_include_directories rather than
# paths relative to the source, so "buffer.h" style quoted includes are project
# headers and must not be reordered into the system-header block.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Pointer/reference binding: `int* p`, `const T& r` -- as used throughout.
DerivePointerAlignment: false
PointerAlignment: Left

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true

# Every file ends with exactly one newline (POSIX text file; avoids
# "\ No newline at end of file" noise in differs". Rquires clang-format >= 16
InsertNewlineAtEOF: true

# NOTE: clang-format 18 (the CI version, Ubuntu24.04) mis-parses and
# elaborated type with a braced initializer -- `struct pollfd pdf{fd, POLLIN, 0};`
# -- as a struct definition and splits it over three lines while newer version
# keep it on on. No option fixes this, so write `pollfd pfd{...};`
# (the  `struct` keyword is redundant in C++) got get identical output from
# every version.
