#!/usr/bin/env bash
set -euo pipefail

if [ "${COX_NO_FORMAT:-0}" = "1" ]; then
    exit 0
fi

if ! command -v clang-format >/dev/null 2>&1; then
    exit 0
fi

# Dynamically gather submodule paths to exclude them using Git's :^ exclusion syntax
excludes=()
while IFS= read -r sm; do
    [ -n "$sm" ] && excludes+=(":^$sm")
done < <(git config --file .gitmodules --get-submodule.path 2>/dev/null || true)

# Find staged files matching .cc/.h, excluding submodules natively
mapfile -t files < <(
    git diff --cached --name-only --diff-filter=ACM -- '*.cc' '*.h' "${excludes[@]}" || true
)

[ "${#files[@]}" -eq 0 ] && exit 0

clang-format -i "${files[@]}"
git add -- "${files[@]}"
