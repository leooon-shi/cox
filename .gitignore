# Build output. CMakePresets puts each configuration in its own subdirectory
# (build/clang-debug, build/tsan, ...), so ignore the whole tree.
/build/
build/

# CMake user-specific presets (CMakePresets.json IS tracked; this override
# file is per-developer by convention).
CMakeUserPresets.json

# Editor / tooling
.vscode/
.idea/
*.swp
*~
.cache/
compile_commands.json

# Sanitizer / coverage artifacts
*.gcda
*.gcno
*.gcov
coverage/
*.profraw
*.profdata

# Build byproducts
*.o
*.a
*.so
*.log

# Saved AI-assistant conversation transcripts (e.g. cox_ev_leftovers.json --
# a ~6MB dump that is not project data). Ignored rather than deleted; remove it
# mannually if unwanted.
cox_ev_leftovers.json
*_leftovers.json
