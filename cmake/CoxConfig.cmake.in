@PACKAGE_INIT@

# CoxConfig.cmake -- package config for find_package(Cox).
#
# Re-find external dependencies that Cox's targets link PUBLICly, so their
# imported targets (OpenSSL::SSL, etc.) exist before we pull in CoxTargets.
# Without this, consuming CoxTargets.cmake would reference targets that have
# not been defined in the consumer's project.

include (CMakeFindDependencyMacro)

# TLS is a core capability; OpenSSL is always required.
find_dependency(Threads)
find_dependency(OpenSSL)

# c-ares is optional: only a dependency if Cox was built with COX_HAVE_CARES.
# The flag is baked in at configure time via @COX_HAVE_CARES@.
if(@COX_HAVE_CARES@)
    # c-ares has no standard config package name across distros; the library
    # was found by path at build time. Consumers linkng cox_net inerit the
    # absolute path recorded in the export set, so no re-find is required here.
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CoxTargets.cmake")

check_required_components(Cox)
